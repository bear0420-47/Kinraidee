{
  "openapi": "3.0.0",
  "info": {
    "title": "Kinraidee API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kinraidee_auth"
      }
    },
    "schemas": {
      "AuthCredentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "AuthUserEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "USER",
                      "ADMIN"
                    ]
                  }
                },
                "required": [
                  "id",
                  "email",
                  "role"
                ]
              }
            },
            "required": [
              "user"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "UploadImageEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "image": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.(?:jpg|png|webp)$"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "url"
                ]
              }
            },
            "required": [
              "image"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "UploadErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Localization": {
        "type": "object",
        "properties": {
          "th": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "th",
          "en"
        ],
        "additionalProperties": false
      },
      "CreateZoneRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "properties": {
              "th": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "th",
              "en"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "nullable": true,
            "properties": {
              "th": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "th",
              "en"
            ],
            "additionalProperties": false
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "sortOrder"
        ],
        "additionalProperties": false
      },
      "UpdateZoneRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "properties": {
              "th": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "th",
              "en"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "nullable": true,
            "properties": {
              "th": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "th",
              "en"
            ],
            "additionalProperties": false
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "ZoneListEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "object",
                      "properties": {
                        "th": {
                          "type": "string",
                          "minLength": 1
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "th",
                        "en"
                      ],
                      "additionalProperties": false
                    },
                    "description": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "th": {
                          "type": "string",
                          "minLength": 1
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "th",
                        "en"
                      ],
                      "additionalProperties": false
                    },
                    "sortOrder": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "description",
                    "sortOrder"
                  ]
                }
              }
            },
            "required": [
              "items"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "ZoneEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "zone": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "object",
                    "properties": {
                      "th": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "th",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "description": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "th": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "th",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "sortOrder": {
                    "type": "integer"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "description",
                  "sortOrder",
                  "createdAt",
                  "updatedAt"
                ]
              }
            },
            "required": [
              "zone"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "CreateFoodTypeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "properties": {
              "th": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "th",
              "en"
            ],
            "additionalProperties": false
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "sortOrder"
        ],
        "additionalProperties": false
      },
      "UpdateFoodTypeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "properties": {
              "th": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "th",
              "en"
            ],
            "additionalProperties": false
          },
          "icon": {
            "type": "string",
            "nullable": true,
            "maxLength": 50
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "FoodTypeListEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "object",
                      "properties": {
                        "th": {
                          "type": "string",
                          "minLength": 1
                        },
                        "en": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "th",
                        "en"
                      ],
                      "additionalProperties": false
                    },
                    "icon": {
                      "type": "string",
                      "nullable": true
                    },
                    "sortOrder": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "icon",
                    "sortOrder"
                  ]
                }
              }
            },
            "required": [
              "items"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "FoodTypeEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "foodType": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "object",
                    "properties": {
                      "th": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "th",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "icon": {
                    "type": "string",
                    "nullable": true
                  },
                  "sortOrder": {
                    "type": "integer"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updatedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "icon",
                  "sortOrder",
                  "createdAt",
                  "updatedAt"
                ]
              }
            },
            "required": [
              "foodType"
            ]
          }
        },
        "required": [
          "data"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registered user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "responses": {
          "204": {
            "description": "Logged out"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUserEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/images": {
      "post": {
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "image"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored local image",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadImageEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Image exceeds the configured limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported image type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Local upload storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/images/{fileName}": {
      "delete": {
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.(?:jpg|png|webp)$"
            },
            "required": true,
            "name": "fileName",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted local image"
          },
          "400": {
            "description": "Invalid generated file name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Administrator access required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Upload not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Local upload storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/uploads/{fileName}": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.(?:jpg|png|webp)$"
            },
            "required": true,
            "name": "fileName",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Local image in development or test",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Image unavailable"
          }
        }
      }
    },
    "/api/zones": {
      "get": {
        "responses": {
          "200": {
            "description": "All zones ordered by sortOrder, then Thai name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneListEnvelope"
                }
              }
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateZoneRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created zone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated user is not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Thai or English name already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/zones/{id}": {
      "patch": {
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateZoneRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated zone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated user is not an administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Zone not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Thai or English name already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
