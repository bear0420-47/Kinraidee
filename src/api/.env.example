DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinraidee
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kinraidee
JWT_SECRET=replace-with-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
LOCAL_UPLOADS_ENABLED=true
LOCAL_UPLOADS_DIRECTORY=.local/uploads
LOCAL_UPLOAD_MAX_BYTES=2097152
EXTERNAL_PROVIDER_TIMEOUT_MS=5000

# Optional provider paths. Missing keys keep deterministic recommendations and unavailable place details.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_PLACES_API_KEY=

# Optional: only for `pnpm --filter api catalog:photos` (dish photo search). Never used by the app.
UNSPLASH_ACCESS_KEY=
