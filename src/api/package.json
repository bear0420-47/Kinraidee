{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js && pnpm openapi:generate",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run --exclude 'dist/**'",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "prisma": "prisma",
    "catalog:build": "node --import tsx prisma/catalog-build.ts",
    "catalog:photos": "node --env-file-if-exists=.env --import tsx prisma/catalog-photos.ts",
    "catalog:places": "node --env-file-if-exists=.env --import tsx prisma/catalog-places.ts",
    "openapi:generate": "node --import tsx src/openapi/generateOpenapi.ts",
    "recommendations:verify": "node --env-file-if-exists=.env --import tsx src/scripts/verifyRecommendations.ts",
    "providers:verify": "node --env-file-if-exists=.env --import tsx src/scripts/verifyProviders.ts",
    "audit-logs:prune": "node --env-file-if-exists=.env --import tsx src/scripts/pruneAuditLogs.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "multer": "^2.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
